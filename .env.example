# The Guardian mobile app environment
# Copy to .env.development / .env.production as needed.
# EXPO_PUBLIC_* variables are inlined by Expo at bundle time; restart Metro after changes.

# Backend gateway URL used by src/services/api.ts (no trailing slash).
# While developing against a local backend, use your LAN IP, e.g.:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:4000
EXPO_PUBLIC_API_BASE_URL=https://guardian-vault-gateway.onrender.com
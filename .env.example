# Shared database (Neon PostgreSQL)
DATABASE_URL=jdbc:postgresql://YOUR_HOST/YOUR_DATABASE?sslmode=require
DATABASE_USERNAME=YOUR_DATABASE_USERNAME
DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD

# Shared internal authentication
INTERNAL_SERVICE_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Auth
JWT_SECRET=REPLACE_WITH_A_BASE64_SECRET_OF_AT_LEAST_32_BYTES
JWT_EXPIRATION=YOUR_JWT_EXPIRATION_TIME

# Subscription / Paystack
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_CALLBACK_URL=http://localhost:8080/vault/payments/callback
MANUAL_SUBSCRIPTION_UPGRADE_ENABLED=false

# Vault encryption
VAULT_PASSWORD_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
VAULT_DOCUMENT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
BACKUP_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Gmail API email delivery
GMAIL_CLIENT_ID=REPLACE_ME
GMAIL_CLIENT_SECRET=REPLACE_ME
GMAIL_REFRESH_TOKEN=REPLACE_ME
GMAIL_FROM=you@example.com
DEMO_MODE=true
ADMIN_SUPPORT_EMAIL=you@example.com

# Backblaze B2
B2_ENABLED=false
B2_ENDPOINT=YOUR_B2_ENDPOINT
B2_REGION=YOUR_B2_REGION
B2_BUCKET=REPLACE_ME
B2_KEY_ID=REPLACE_ME
B2_APPLICATION_KEY=REPLACE_ME

# Runtime profile
SPRING_PROFILES_ACTIVE=prod

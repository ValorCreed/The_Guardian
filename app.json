{
  "expo": {
    "name": "The Guardian",
    "slug": "guardian",
    "version": "4.0.0",
    "orientation": "portrait",
    "scheme": "theguardian",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/GuardianAdaptiveForeground_safe_50.png",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#061A12",
        "foregroundImage": "./src/assets/GuardianAdaptiveForeground_safe_50.png",
        "monochromeImage": "./src/assets/GuardianMonochrome_safe_55.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.vault.theguardian",
      "runtimeVersion": "1.0.0",
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/GuardianAdaptiveForeground_safe_50.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./src/assets/GuardianSplashNativeIcon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./src/assets/GuardianSplashNativeIcon.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow The Guardian to use Face ID for secure biometric sign-in."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/GuardianNotificationMonochrome.png",
          "color": "#0B8FAC",
          "defaultChannel": "guardian-security"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d781bbf-3d4c-4af8-abd5-43a09edea95d"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/0d781bbf-3d4c-4af8-abd5-43a09edea95d"
    }
  }
}
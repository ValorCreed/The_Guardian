# ------------------------------------------------------------------
# The Guardian vault gateway - environment configuration
# Copy to .env and fill in real values. Never commit the .env file.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (use a strong role/password in production)
DATABASE_URL=postgres://guardian:guardian@localhost:5432/guardian

# At least 16 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# At least 16 characters (32 preferred). Salt for AES-256-GCM vault encryption.
VAULT_ENCRYPTION_KEY=change-me-in-production

# SMTP / email (leave SMTP_HOST empty to disable outbound email; verification
# codes still reach the logs via recordTestCode in NODE_ENV=test)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@guardian.vault

# Expo push notifications (leave empty to skip push; API errors degrade gracefully)
EXPO_ACCESS_TOKEN=

# Payments (sandbox grants plans instantly without a real charge)
PAYMENT_PROVIDER=paystack
PAYMENTS_SANDBOX=true
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Origin of the deployed app (CORS + payment callback links)
APP_ORIGIN=https://guardian-vault-gateway.onrender.com

# Local artifact storage for encrypted documents and backups
STORAGE_DIR=./storage

ALLOWED_ORIGINS=*
CODE_EXPIRES_IN_MINUTES=10
SESSION_TTL_DAYS=30
MAX_DOCUMENT_BYTES=26214400